[Unit]
Description=IMP-AgriBot ROS 2 bringup
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/yvette_pi
Type=simple
User=yvette_pi
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source ~/ros2_ws/install/setup.bash && ros2 launch robot_control bringup.launch.py'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
